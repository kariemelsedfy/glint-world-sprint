{
  "name": "glint-world-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:itch": "node scripts/package-itch.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "^3.0.5"
  }
}
